{
  // 1. Find the CCSPlayerPawn vtable.
  //    Linux: _ZTV13CCSPlayerPawn, functions start 0x10 after it.
  //    Windows: xref ??_R4CCSPlayerPawn@@6B@, functions start 8 bytes after that xref.
  // 2. Take the function at index 256 on Linux and 255 on Windows.
  // 3. It's a short function that passes its CTakeDamageResult argument to a pawn component
  //    function, which calls the function that fires the "player_hurt" event.
  "CCSPlayerPawn::OnTakeDamage_Alive": {
    "linux": 256,
    "windows": 255
  },
  // 1. Search for the "Prohibiting %s\n" string, its only xref is the mp_items_prohibited callback.
  // 2. For each item in the ConVar, it compares the definition's index, a word at the offset.
  "CEconItemDefinition::m_nDefIndex": {
    "linux": 16,
    "windows": 16
  },
  // 1. Find the mp_items_prohibited callback (see CEconItemDefinition::m_nDefIndex).
  // 2. It prints the definition's name, a pointer at the offset, with "Prohibiting %s\n".
  "CEconItemDefinition::m_pszDefinitionName": {
    "linux": 608,
    "windows": 608
  },
  // 1. Search for the "Player.Respawn" string, its only xref is in the pawn's spawn function.
  // 2. It calls SetModelFromLoadout and then SetModelFromClass, back to back, with only the pawn.
  // 3. SetModelFromLoadout checks the agent's definition with cmp dword ptr [def + offset], 26h
  //    (LOADOUT_SLOT_CLOTHING_CUSTOMPLAYER).
  "CEconItemDefinition::m_iDefaultLoadoutSlot": {
    "linux": 824,
    "windows": 824
  }
}
